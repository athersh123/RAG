# Logs and Temporary Files
# ============================================

*.log
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig

# ============================================
# Environment Variables and Secrets
# ============================================

.env
.env.local
.env.*.local
*.key
secrets.json
api_keys.txt

